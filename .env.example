# ── Server ──────────────────────────────────────────────
PORT=3000

# ── Database (Neon Postgres) ───────────────────────────
# Pooled connection string (pgbouncer) used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/neondb?sslmode=require"
# Direct connection string used for migrations / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.neon.tech/neondb?sslmode=require"

# ── Auth ───────────────────────────────────────────────
# Secret used to sign admin JWTs. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"
# Admin credentials (seeded into the DB on first run).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# ── Public write protection (optional) ────────────────
# If set, public POST endpoints (leads, analytics, clicks, assistant)
# require this value in the `x-api-key` header.
API_KEY=""

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS="https://portfolio-2-frontend.vercel.app,http://localhost:3000"

# ── Email (Nodemailer / Gmail) ─────────────────────────
# Gmail requires an App Password (not your normal password).
SMTP_EMAIL=""
SMTP_PASSWORD=""

# ── Expo push notifications ────────────────────────────
# Leave empty to disable push. Access token is optional for Expo push.
EXPO_ACCESS_TOKEN=""
